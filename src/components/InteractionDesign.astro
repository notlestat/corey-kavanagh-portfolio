---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import DigitalWork from "./DigitalWork.astro";
import SiteFooter from "./SiteFooter.astro";
import { workDisciplines } from "../workDisciplines";
import "../work.css";
import "../experimental-work.css";
import "../edited-work.css";
---
<BaseLayout title="Interaction design | Corey Kavanagh" description={workDisciplines[1].note} page="work">
  <a class="work-skip" href="#interaction-content">Skip to interaction design</a>
  <Header page="work" />
  <main class="work-refresh edited-discipline minimal-work-page work-container" id="interaction-content">
    <a class="case-back" href="/work">All work</a>
    <header class="edited-heading"><h1><span class="rise"><span>Interaction design.</span></span></h1><p class="sr-only">{workDisciplines[1].note}</p></header>
    <DigitalWork category="interaction-design" />
  </main>
  <SiteFooter back={{ href: "/work", label: "Back to Work" }} />
</BaseLayout>
