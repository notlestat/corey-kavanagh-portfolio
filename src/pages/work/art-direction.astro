---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import CaseStudies from "../../components/CaseStudies.astro";
import "../../work.css";
---
<BaseLayout title="Art direction | Corey Kavanagh" page="work">
  <a class="work-skip" href="#art-content">Skip to case studies</a>
  <Header page="work" />
  <main class="work-refresh discipline-page work-container" id="art-content">
    <a class="case-back" href="/work">All work</a>
    <header class="case-page-heading"><p class="work-label">Art direction / Case studies</p><h1>Behind the images.</h1><p>A closer look at my role, the context and the work.</p></header>
    <CaseStudies />
  </main>
  <footer class="work-footer work-container"><span>Corey Kavanagh</span><a href="/work">Back to Work</a></footer>
</BaseLayout>
