---
import type { CaseStudy } from "../caseStudyData";
interface Props { study: CaseStudy; }
const { study } = Astro.props;
const pages = (study.displayMedia ?? []).slice(0, 3);
---
<section class="website-bundle" aria-labelledby="website-project-title">
  <header class="website-bundle-heading">
    <div><h1 id="website-project-title">{study.name}</h1><p>{study.role}</p></div>
    {study.liveUrl && <a href={study.liveUrl} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${study.name}, opens in a new tab`}>Visit website <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a>}
  </header>
  <div class="website-bundle-pages" data-page-count={pages.length}>
    {pages.map((page, index) => <figure class="website-page">
      <a href={page.src} target="_blank" rel="noopener noreferrer" aria-label={`View ${study.name}: ${page.label}, image opens in a new tab`}>
        <img src={page.src} alt={page.alt} width={page.width} height={page.height} loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} />
      </a>
    </figure>)}
  </div>
  <p class="website-bundle-description">{study.summary}</p>
</section>
<style>
  .website-bundle { width: min(100%, 820px); margin: 28px auto 64px; }
  .website-bundle-heading { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 20px; margin-bottom: 36px; }
  .website-bundle-heading h1 { margin: 0 0 8px; font: 400 24px/1.2 var(--sans-font); letter-spacing: -.025em; }
  .website-bundle-heading p, .website-bundle-heading > a { margin: 0; font: 400 11px/1.5 var(--label-font); color: var(--muted); }
  .website-bundle-heading > a { display: inline-flex; align-items: center; gap: 10px; text-underline-offset: 4px; }
  .website-bundle-pages { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: start; isolation: isolate; padding: 4px 0 16px; }
  .website-page { position: relative; grid-column: 1 / 11; margin: 0; }
  .website-page:nth-child(2) { grid-column: 5 / -1; margin-top: -24%; }
  .website-page:nth-child(3) { margin-top: -14%; }
  .website-page a { display: block; padding: 6px; border-radius: 3px; background: var(--paper); box-shadow: inset 0 1px 1px rgb(255 255 255 / .8), 0 4px 6px rgb(0 0 0 / .04), 0 14px 24px rgb(0 0 0 / .08); }
  .website-page img { display: block; width: 100%; height: auto; }
  .website-page:focus-within { z-index: 2; }
  .website-page a:focus-visible, .website-bundle-heading > a:focus-visible { outline: 2px solid var(--ink); outline-offset: 5px; }
  .website-bundle-description { margin: 28px 0 0; max-width: 54ch; font: 400 14px/1.7 var(--sans-font); color: var(--muted); text-wrap: pretty; }
  [data-page-count="1"] .website-page:first-child { grid-column: 2 / 12; }
  @media (hover: hover) { .website-page:hover { z-index: 2; } }
  @media (max-width: 700px) {
    .website-bundle { margin-top: 22px; margin-bottom: 40px; }
    .website-bundle-heading { margin-bottom: 28px; }
    .website-bundle-heading h1 { font-size: 22px; }
    .website-page a { padding: 4px; }
  }
</style>
