---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import WorkFolder from "../WorkFolder";
import "../work.css";
import "../folder.css";
---
<BaseLayout title="Work | Corey Kavanagh" page="work">
  <a class="work-skip" href="#work-content">Skip to work</a>
  <Header page="work" />
  <main class="work-refresh folder-page" id="work-content">
    <WorkFolder client:load />
  </main>
  <footer class="folder-footer"><span>Corey Kavanagh / Selected work</span><a href="/work/archive" data-slot="archive-link">Image archive</a></footer>
  <script is:inline>
    // Keep previously shared work-index links pointed at the preserved list.
    if (location.hash === "#work-index") location.replace("/work/archive#work-index");
  </script>
</BaseLayout>
