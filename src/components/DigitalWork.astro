---
import { systems } from "../systemData";
import SystemRow from "../SystemRow";
import { caseStudies } from "../caseStudyData";
interface Props { category: "interaction-design" | "creative-technology"; }
const { category } = Astro.props;
const creative = category === "creative-technology";
const projects = caseStudies.filter(study => study.category === category);
---
<section class="engineering-systems" id="digital-work" aria-labelledby="systems-title">
  <h2 class="work-label" id="systems-title">Selected case studies</h2>
  <div class="systems-list">
    <div class:list={["digital-compositions", { "digital-compositions-creative": creative }]}>
      {projects.map((project) => project.listingMedia && <article class:list={["digital-composition", { "digital-composition-solo": !project.listingDetail }]}>
        <a class="digital-composition-main" href={`/work/${project.slug}`}>
          <figure><img src={project.listingMedia.src} width={project.listingMedia.width} height={project.listingMedia.height} alt={project.listingMedia.alt} loading="lazy" /><figcaption><h3>{project.name}</h3><span>{project.role}</span><span aria-hidden="true">↗</span></figcaption></figure>
        </a>
        {project.listingDetail && <a class="digital-composition-detail" href={`/work/${project.slug}`} aria-label={`${project.name}, project detail`}><img src={project.listingDetail.src} width={project.listingDetail.width} height={project.listingDetail.height} alt={project.listingDetail.alt} loading="lazy" /></a>}
        <p class="digital-composition-note">{project.summary}</p>
      </article>)}
    </div>
    {creative && <div class="creative-workflows"><h3>In the studio</h3>{systems.map((item, index) => <SystemRow item={item} index={index + projects.length} client:load />)}</div>}
  </div>
</section>
