---
import type { CaseStudy } from "../caseStudyData";

interface Props {
  next?: CaseStudy;
  backHref: string;
  backLabel: string;
  /** Link to all work when there is no next project. */
  allWork?: boolean;
}

const { next, backHref, backLabel, allWork = false } = Astro.props;
const image = next && (next.listingMedia ?? next.displayMedia?.[0] ?? next.media[0]);
const srcSet = next && !next.listingMedia && !next.displayMedia ? next.media[0]?.srcSet : undefined;
---
<nav class="case-next" aria-label="Case study navigation">
  <a class="case-next-back" href={backHref}>{backLabel}</a>
  {next && image ? <a class="case-next-project" href={`/work/${next.slug}`}>
    <span class="case-next-copy"><span class="work-label">Next project</span><span class="case-next-name">{next.name}</span></span>
    <span class="case-next-image"><img src={image.src} srcset={srcSet} sizes="170px" alt="" loading="lazy" style={`view-transition-name: work-${next.slug}`} /></span>
  </a> : allWork && <a class="case-next-back" href="/work">All work</a>}
</nav>
