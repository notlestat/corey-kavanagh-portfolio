---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import DigitalWork from "./DigitalWork.astro";
import PointStudy from "./PointStudy.astro";
import Contact from "./Contact.astro";
import { workDisciplines } from "../workDisciplines";
import "../work.css";
import "../experimental-work.css";
import "../edited-work.css";
---
<BaseLayout title="Creative technology | Corey Kavanagh" description={workDisciplines[2].note} page="work">
  <a class="work-skip" href="#technology-content">Skip to creative technology</a>
  <Header page="work" />
  <main class="work-refresh edited-discipline work-container" id="technology-content">
      <a class="case-back" href="/work">All work</a>
      <header class="edited-heading"><h1>Creative technology.</h1><p class="sr-only">{workDisciplines[2].note}</p></header>
      <PointStudy />
      <DigitalWork category="creative-technology" />
  </main>
  <footer class="work-footer work-container"><Contact /><a href="/work">Back to Work</a></footer>
</BaseLayout>
