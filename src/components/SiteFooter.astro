---
import Contact from "./Contact.astro";
import LiveClock from "./ui/live-clock";
import { GithubIcon } from "../Navigation";

interface Props {
  /** Home already shows the phone number beside the introduction. */
  contact?: boolean;
  /** Work pages carry the GitHub link in their header. */
  github?: boolean;
  /** Pass false on a page that does not scroll. */
  back?: { href: string; label: string } | false;
}

const { contact = true, github = false, back = { href: "#top", label: "Back to top" } } = Astro.props;
---
<footer class="site-foot work-container">
  {contact && <Contact />}
  <LiveClock client:idle />
  {github && <a class="site-foot-github" href="https://github.com/notlestat" target="_blank" rel="noopener noreferrer" aria-label="GitHub, opens in a new tab"><GithubIcon /></a>}
  {back && <a class="site-foot-back" href={back.href}>{back.label}</a>}
</footer>

<style is:global>
  /* One footer for every page: contact, where and when, GitHub, the way back. */
  .site-foot { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 28px; padding-block: 28px 40px; color: var(--muted); font: 400 10px/1.5 var(--label-font); }
  .site-foot .portfolio-contact { font-size: 10px; margin-right: auto; }
  .site-foot .live-clock { display: flex; flex-wrap: wrap; gap: 4px 20px; margin: 0; }
  .site-foot .live-clock:first-child { margin-right: auto; }
  .site-foot .live-clock time { margin-left: 8px; color: var(--ink); font-variant-numeric: tabular-nums; }
  .site-foot a { display: inline-flex; align-items: center; min-height: 44px; }
  .site-foot-github, .site-foot-back { text-decoration: none; white-space: nowrap; }
  .site-foot-github { justify-content: center; min-width: 44px; margin-inline: -14px; }
  .site-foot-github svg { width: 15px; height: 15px; }
  @media (hover: hover) and (pointer: fine) {
    .site-foot-github:hover, .site-foot-back:hover { color: var(--ink); }
    .site-foot-back:hover { text-decoration: underline; text-underline-offset: 4px; }
  }
  @media (max-width: 700px) {
    .site-foot { gap: 0 20px; padding-block: 20px 28px; }
    .site-foot .portfolio-contact { flex-basis: 100%; }
    .site-foot .live-clock { margin-right: auto; }
  }
</style>
