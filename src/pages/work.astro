---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import WorkFolder from "../WorkFolder";
import Contact from "../components/Contact.astro";
import "../work.css";
import "../folder.css";
---
<BaseLayout title="Work | Corey Kavanagh" page="work">
  <a class="work-skip" href="#work-content">Skip to work</a>
  <Header page="work" />
  <main class="work-refresh folder-page" id="work-content">
    <WorkFolder client:load />
  </main>
  <footer class="folder-footer"><Contact /></footer>
  <script is:inline>
    // Keep previously shared index links pointed at Design projects.
    if (location.hash === "#work-index") location.replace("/work/design#case-studies");
  </script>
</BaseLayout>
