---
import OnePageLayout from "../layouts/OnePageLayout.astro";
import Signature from "../components/Signature.astro";
import { projects as allProjects, publishable, type Project } from "../onePageProjects";

// Draft prompts show while developing locally and are left out of the published site.
const projects = publishable(allProjects, import.meta.env.DEV);
const num = (i: number) => String(i + 1).padStart(2, "0");

// Pile layouts: [x, y, height] as a percentage of the pile's width; the last entry sits on top.
const LAYOUT: Record<number, [number, number, number][]> = {
  1: [[0, 0, 36]],
  3: [[-17, -3, 30], [16, -5, 28], [1, 3, 34]],
  5: [[-25, -2, 30], [17, -7, 28], [-9, 6, 31], [22, 4, 27], [2, 0, 34]],
};
// The first image ends up on top, so piles are built back to front.
function pile(p: Project) {
  const count = p.slides.length >= 5 ? 5 : p.slides.length >= 3 ? 3 : 1;
  const pos = LAYOUT[count];
  return p.slides.slice(0, count).map((slide, k) => ({ slide, pos: pos[count - 1 - k] })).reverse();
}
const countLabel = (p: Project) => p.video ? "film" : p.slides.length > 1 ? `${p.slides.length} images` : "1 image";
---
<OnePageLayout title="Corey Kavanagh | Design">
  <main id="top">
    <header class="hero col">
      <button class="sig" id="sig" type="button" aria-label="C.K signature, replay"><Signature /></button>
      <div class="letter" id="letter">
        <p>Hey,</p>
        <p>I'm <b>Corey Kavanagh</b>, a designer in <b>London</b>.</p>
        <p>I started in art direction, making covers, campaigns and imagery for music and fashion. Now I design websites and <span class="code-hover" id="code-word" aria-label="digital products">digital products</span>, and I'm learning to build them too. Product and growth design is where I'm heading.</p>
        <p>Drawn to fashion, industrial forms and the quieter side of design.</p>
        <p>Reach me on <a class="chip" href="tel:+447343043662">+44 7343 043662</a> or <a class="chip" href="https://github.com/notlestat" target="_blank" rel="noopener noreferrer">GitHub</a>. I'm open to projects.</p>
      </div>
      <span class="code-tag" id="code-tag" aria-hidden="true">&lt;Design /&gt;</span>

      <nav class="index" aria-labelledby="index-title">
        <h2 id="index-title">Selected work</h2>
        <div>
          {projects.map((p, i) => (
            <a href={`#${p.id}`}><span class="g">{num(i)}</span><span class="nm">{p.name}</span><span class="g"><span class="rl">{p.meta[0][1]} · </span>{p.meta[1][1]}</span></a>
          ))}
        </div>
      </nav>
    </header>

    <section class="work" aria-label="Projects">
      {projects.map((p, pi) => (
        <article class="project" id={p.id} aria-labelledby={`h-${p.id}`}>
          <h3 id={`h-${p.id}`}>{p.name}</h3>
          {p.product ? (
            <div class="pile product">
              <figure class="card home" style="--x:-16;--y:-4;--h:34">
                <img src={p.slides[0].src} alt="" width={p.slides[0].width} height={p.slides[0].height} loading="lazy" />
                <button class="open" type="button" data-p={pi} aria-label={`Open the ${p.name} case`}></button>
              </figure>
              <figure class="card slc" style="--x:14;--y:3;--h:0" aria-label="Working copy of the SourceLink savings calculator">
                <div class="slc-top"><span class="slc-logo">SourceLink</span><span class="slc-l">Savings calculator</span></div>
                <div class="slc-panel">
                  <div class="slc-row">
                    <label><span class="slc-l">Your current price, per unit</span><span class="slc-in">£ <input type="number" id="slc-price" value="19" min="0" step="0.5" inputmode="decimal" /></span></label>
                    <label><span class="slc-l">Units in this order</span><span class="slc-units"><b id="slc-units-out">500</b><small>Units</small></span><input type="range" id="slc-units" min="50" max="5000" step="50" value="500" /></label>
                  </div>
                  <div class="slc-row">
                    <div class="slc-out"><span class="slc-l">Current order cost</span><b id="slc-cur">£9,500</b><span class="slc-bar"><i style="width:100%"></i></span></div>
                    <div class="slc-out"><span class="slc-l">Estimated with SourceLink</span><b class="acc" id="slc-new">£7,315</b><span class="slc-bar"><i class="acc" style="width:77%"></i></span></div>
                  </div>
                  <div class="slc-save"><span class="slc-l">Estimated saving · 23%</span><b id="slc-save" aria-live="polite">£2,185</b><small>On this order, at your current unit price.</small></div>
                </div>
                <p class="slc-note">Rebuilt from sourcelink.solutions. Modelled at a 23% price reduction.</p>
              </figure>
            </div>
          ) : (
            <button class="pile" type="button" data-p={pi} aria-label={`Open ${p.name}, ${countLabel(p)}`}>
              {pile(p).map(({ slide, pos: [x, y, h] }) => p.video ? (
                <figure class="card wide" style={`--x:${x};--y:${y};--h:${h}`}><video src={p.video.src} poster={p.video.poster} muted loop playsinline autoplay aria-hidden="true"></video></figure>
              ) : (
                <figure class="card" style={`--x:${x};--y:${y};--h:${h}`}><img src={slide.src} alt="" width={slide.width} height={slide.height} loading="lazy" /></figure>
              ))}
            </button>
          )}
          <div class="p-meta">
            {p.product && <span class="tag">Product case</span>}
            <span class="g">{p.meta[0][1]}</span><span class="g">{p.meta[1][1]}</span>
            <button class="u" type="button" data-p={pi}>{p.product ? "Read the case" : "About the project"}</button>
            {p.link && <a class="u" href={p.link.href} target="_blank" rel="noopener noreferrer">{p.link.label}</a>}
          </div>
        </article>
      ))}
    </section>

    <footer class="col"><span class="g">London <b id="ldn">--:--</b> · New Zealand <b id="nz">--:--</b></span><a class="g u" href="#top">Back to top</a></footer>
  </main>
  <div class="edge-blur" aria-hidden="true"><span></span><span></span><span></span></div>

  <dialog class="sheet" id="sheet" aria-labelledby="sheet-title">
    <button class="sheet-close" type="button" data-close>Close</button>
    <div class="sheet-inner">
      <div class="sheet-media">
        <div class="sheet-stage" id="sheet-stage"></div>
        <div class="sheet-cap"><span class="g" id="sheet-cap"></span><span class="g" id="sheet-count"></span></div>
        <div class="thumbs" id="sheet-thumbs" role="group" aria-label="Project images"></div>
      </div>
      <div class="sheet-info">
        <span class="g" id="sheet-kicker"></span>
        <h2 id="sheet-title"></h2>
        <p class="lead" id="sheet-summary"></p>
        <dl class="sheet-meta" id="sheet-meta"></dl>
        <div class="sheet-body" id="sheet-body"></div>
        <div class="sheet-foot" id="sheet-foot"></div>
      </div>
    </div>
  </dialog>

  <script type="application/json" id="project-data" set:html={JSON.stringify(projects).replace(/</g, "\\u003c")}></script>
  <script src="../scripts/one-page.ts"></script>
</OnePageLayout>
