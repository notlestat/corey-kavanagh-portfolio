---
import "../styles.css";
import "../visualTheme.css";
import "../home.css";
import type { Page } from "../Navigation";

interface Props {
  title: string;
  page: Page;
  description?: string;
}

const { title, page, description = "Corey Kavanagh works across design, branding and creative technology." } = Astro.props;
// Share cards need absolute URLs; `site` in astro.config.mjs supplies the origin.
// scripts/generate-share-image.mjs exports the 1200 × 630 card.
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL("/og/default.jpg", Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Corey Kavanagh" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A still from Corey Kavanagh's moving-image work" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#eeefeb" />
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem("corey-theme");
          const theme = savedTheme === "light" || savedTheme === "dark"
            ? savedTheme
            : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.dataset.theme = theme;
          document.querySelector('meta[name="theme-color"]').setAttribute("content", theme === "dark" ? "#000000" : "#eeefeb");
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <div id="top" class={`site-shell page-${page}`}><slot /></div>
  </body>
</html>
