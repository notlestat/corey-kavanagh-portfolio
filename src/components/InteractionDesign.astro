---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import DigitalWork from "./DigitalWork.astro";
import Contact from "./Contact.astro";
import { workDisciplines } from "../workDisciplines";
import "../work.css";
import "../experimental-work.css";
import "../edited-work.css";
---
<BaseLayout title="Interaction design | Corey Kavanagh" page="work">
  <a class="work-skip" href="#interaction-content">Skip to interaction design</a>
  <Header page="work" />
  <main class="work-refresh edited-discipline minimal-work-page work-container" id="interaction-content">
    <a class="case-back" href="/work">All work</a>
    <header class="edited-heading"><h1>Interaction design.</h1><p class="sr-only">{workDisciplines[1].note}</p></header>
    <DigitalWork category="interaction-design" />
  </main>
  <footer class="work-footer work-container"><Contact /><a href="/work">Back to Work</a></footer>
</BaseLayout>
