---
import { caseStudies } from "../caseStudyData";
import { ImagesScrollingAnimation } from "./ui/images-scrolling-animation";
interface Props { category: "interaction-design" | "creative-technology"; }
const { category } = Astro.props;
const projects = caseStudies.filter(project => project.featured && project.category === category).map(project => {
  const image = project.listingMedia ?? project.displayMedia?.[0] ?? project.media[0];
  return {
    title: project.name, href: `/work/${project.slug}`, role: project.role,
    src: image.src, alt: image.alt, width: image.width, height: image.height,
  };
});
---
{projects.length > 0 && <div class="digital-projects" id="digital-work"><ImagesScrollingAnimation projects={projects} client:load /></div>}
<style>
  .digital-projects { width: min(100%, 1040px); margin-inline: auto; }
</style>
